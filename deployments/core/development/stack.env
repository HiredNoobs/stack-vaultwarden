# -----------------------------------------------------
# Deployment
# -----------------------------------------------------
THIS=$(realpath "$BASH_SOURCE")
HERE=$(dirname "$THIS")

export ENVIRONMENT_BASE=$(dirname "$THIS")
DEPLOYMENT_BASE=$(dirname "$ENVIRONMENT_BASE")

export ENVIRONMENT=$(basename "$ENVIRONMENT_BASE")
export DEPLOYMENT=$(basename "$DEPLOYMENT_BASE")

export CONFIGS="${ENVIRONMENT_BASE}/configs"
export SECRETS="${ENVIRONMENT_BASE}/secrets"

export STACK_PATH=$(realpath "$HERE/../../../")
export STACK_BASE=$(basename "$STACK_PATH" | sed 's/^stack\-//')
export STACK="${STACK_BASE}_${DEPLOYMENT}"

export CONTEXT="${ENVIRONMENT}.${DEPLOYMENT}"

# -----------------------------------------------------
# Docker
# -----------------------------------------------------
# Vaultwarden
VAULTWARDEN_VERSION="1.37.1"
export VAULTWARDEN_IMAGE="vaultwarden/server:${VAULTWARDEN_VERSION}"

# -----------------------------------------------------
# Configuration
# -----------------------------------------------------
# Only while creating accounts, e.g. on a fresh deployment. deploy warns while it's "true".
export VAULTWARDEN_SIGNUPS_ALLOWED="false"

# The data is kept on this StorageClass, Longhorn from stack-longhorn.
# The volume can't be moved to another StorageClass without recreating it.
export VAULTWARDEN_STORAGE_CLASS="longhorn"
export VAULTWARDEN_VOLUME_SIZE="2Gi"
